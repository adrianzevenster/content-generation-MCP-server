# Google Cloud & Vertex AI Configuration
GOOGLE_GENAI_USE_VERTEXAI=True
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=europe-west1
GEMINI_MODEL_NAME=gemini-2.5-flash

# IMPORTANT: Do NOT set GOOGLE_APPLICATION_CREDENTIALS here
# GCP service account key will be mounted as Docker secret at runtime
# Place your service account JSON file at: ./adk-agent-key.json
# Run: bash scripts/init-secrets.sh to configure secrets

# BigQuery Configuration
MONC_BQ_PROJECT_ID=your-project-id
MONC_BQ_DATASET_ID=monc_content
MONC_BQ_TABLE_ID=generated_ads

# RAG Configuration
# GCS bucket (must exist) + prefix for your delta files / docs
RAG_GCS_BUCKET=gs://your-bucket-name
RAG_GCS_PREFIX=rag/monc

# Embeddings model + dimensionality (must match your index dimensions)
RAG_EMBEDDING_MODEL=gemini-embedding-001
RAG_OUTPUT_DIM=768

# Vertex AI Vector Search Configuration
# Fill these after you create + deploy the index endpoint
RAG_INDEX_RESOURCE_NAME=projects/PROJECT_NUMBER/locations/LOCATION/indexes/INDEX_ID
RAG_INDEX_ENDPOINT_RESOURCE_NAME=projects/PROJECT_NUMBER/locations/LOCATION/indexEndpoints/ENDPOINT_ID
RAG_DEPLOYED_INDEX_ID=monc_rag_01
RAG_PROJECT=your-project-id
RAG_LOCATION=europe-west1

# Internal Service URLs (automatically configured in docker-compose)
COMPLIANCE_API_URL=http://compliance:8001/reviewAd

# Logging Configuration
LOG_LEVEL=INFO

# SECRETS (DO NOT COMMIT):
# -------------------------
# 1. GCP Service Account Key: Place at ./adk-agent-key.json
# 2. API Key: Auto-generated by scripts/init-secrets.sh
#
# After placing adk-agent-key.json, run:
#   bash scripts/init-secrets.sh
#
# This will:
#   - Copy GCP key to secrets/gcp-sa.json
#   - Generate API key at secrets/api-key.txt
#   - Display the API key (save it for API requests)
